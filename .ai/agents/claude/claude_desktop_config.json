{
  "mcpServers": {
    "git-mcp": {
      "command": "node",
      "args": [
        "../../mcp/servers/git-mcp/build/index.js"
      ],
      "env": {}
    },
    "db-mcp": {
      "command": "python3",
      "args": [
        "../../mcp/servers/db-mcp/main.py"
      ],
      "env": {
        "DB_CONNECTION_STRING": "REPLACE_WITH_YOUR_DB_CONNECTION_STRING"
      }
    }
  },
  "globalContextFiles": [
    "../../context/architecture.md",
    "../../context/conventions.md"
  ]
}
